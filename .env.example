# Discord
DISCORD_TOKEN=your_discord_bot_token

# Stalcraft API — https://eapi.stalcraft.net
STALCRAFT_CLIENT_ID=941
STALCRAFT_CLIENT_SECRET=your_secret
# ru = русский сервер
STALCRAFT_REGION=ru

# Gemini OCR для команды /scan
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash

# Excel отрядов (полный путь; иначе ДИТЯ22.xlsx / squads.xlsx в корне)
# SHEET_PATH=C:\Users\you\OneDrive\Документы\ДИТЯ22.xlsx
# Автосинк после стабильного сохранения Excel
# SHEET_AUTO_SYNC=true
# SHEET_WATCH_POLL_SECONDS=0.5
# SHEET_WATCH_DEBOUNCE_SECONDS=2
# SHEET_WATCH_RETRY_SECONDS=3

# Опционально (лучше /setup в Discord):
# GUILD_ID=
# LOG_CHANNEL_ID=
# VOICE_CHANNEL_IDS=id1,id2

# Локальная админ-панель базы (запускается вместе с ботом; ADMIN_UI=0 — выключить)
# ADMIN_UI=1
# ADMIN_PORT=8787
