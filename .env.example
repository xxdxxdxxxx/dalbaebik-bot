# Discord
DISCORD_TOKEN=your_discord_bot_token

# Stalcraft API
STALCRAFT_CLIENT_ID=941
STALCRAFT_CLIENT_SECRET=your_secret
STALCRAFT_REGION=ru

# Gemini OCR для /scan
GEMINI_API_KEY=your_gemini_api_key
# Сколько раз /scan повторяет запрос к Gemini при ошибках (1..30, по умолчанию 12)
# GEMINI_SCAN_ATTEMPTS=12

# Опционально (лучше /setup)
# GUILD_ID=
# LOG_CHANNEL_ID=
# VOICE_CHANNEL_IDS=id1,id2

# Админ-панель
# ADMIN_UI=1
# ADMIN_PORT=8787
# ADMIN_PASSWORD=...        # пароль входа в панель из интернета (без него — только localhost)
# ADMIN_SUPER_PASSWORD=...  # пароль мега-админа: только с ним видны «Чаты» (по умолчанию admin1; пусто — роль отключена)

# Clan Map
# CLANMAP_SUPABASE_URL=https://your-project.supabase.co
# CLANMAP_SUPABASE_SECRET_KEY=your_secret_key
